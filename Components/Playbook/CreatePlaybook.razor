@page "/playbook/create"
@using System.Text.Json
@using System.Text.Json.Nodes
@using Altinn.ApiClients.Dialogporten.Features.V1
@using Digdir.BDB.Dialogporten.ServiceProvider.Components.Input
@using Digdir.BDB.Dialogporten.ServiceProvider.Playbook
@using Digdir.BDB.Dialogporten.ServiceProvider.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.Extensions.Options
@inject ProtectedLocalStorage ProtectedLocalStore
@inject IServiceownerApi ServiceOwnerApi
@inject IPlaybookStateStore StateStore
@inject IOptions<ServiceProviderSettings> ServiceProviderOptions
@inject IJSRuntime Js
@inject ILogger<CreatePlaybook> Logger
@rendermode InteractiveServer
<h3>CreatePlaybook</h3>

<p>
    Creates a Dialogporten dialog, stores the playbook server-side, and applies stage @Cursor.
    The resulting dialog ships with mutate URLs that drive subsequent stages on each user click.
</p>

<fieldset>
    <legend>Import playbook</legend>
    <p style="margin: 0 0 0.5rem 0;">
        Paste a full playbook envelope JSON (Party, serviceResource, playbookState, fceContents) and click Import.
        The form fields below will be populated and you can review/edit before submitting.
    </p>
    <div>
        <textarea id="import" rows="6" cols="100" placeholder="Paste playbook JSON here..."></textarea>
    </div>
    <div>
        <button type="button" @onclick="ImportFromJson">Import</button>
    </div>
</fieldset>

<EditForm Model="Request" OnValidSubmit="Submit" FormName="CreatePlaybook">
    <div>
        <button type="button" @onclick="Prefill">Prefill from sample</button>
    </div>

    <div>
        <label for="serviceResource">Service Resource</label>
        <InputSelect id="serviceResource" @bind-Value="Request.ServiceResource">
            <option value="" disabled selected>Select your option</option>
            @foreach (var resource in ResourceRegistryClient.Resources)
            {
                <option value=@("urn:altinn:resource:" + resource.Identifier)>@resource.Identifier</option>
            }
        </InputSelect>
    </div>

    <div>
        <label for="party">Party</label>
        <InputParty id="party" @bind-Value="Request.Party"/>
    </div>

    <div>
        <label for="cursor">Cursor</label>
        <InputNumber id="cursor" @bind-Value="Cursor"/>
    </div>

    <div>
        <label for="patches">Patches (JSON: array of arrays of patch operations)</label><br/>
        <InputTextArea id="patches" rows="20" cols="100" @bind-Value="PatchesJson"/>
    </div>

    <div>
        <label for="fceContents">FCE contents (JSON: name → {mediaType, content}). Optional.</label><br/>
        <InputTextArea id="fceContents" rows="6" cols="100" @bind-Value="FceContentsJson"/>
    </div>

    <button type="submit">Create Playbook</button>
</EditForm>

@if (DialogId != Guid.Empty)
{
    <fieldset>
        <legend>Playbook ready</legend>
        <p>Dialog id: <code>@DialogId</code></p>
        <p>State id: <code>@StateId</code> (stage @Cursor applied)</p>
    </fieldset>
}

@if (_showPopUp)
{
    <PopUpMessage Header="@_header" Message="@_message" OnClick="() => _showPopUp = false"/>
}

@code {

    private sealed class CreatePlaybookForm
    {
        public string? Party { get; set; }
        public string? ServiceResource { get; set; }
    }

    private CreatePlaybookForm Request { get; set; } = new();
    private int Cursor { get; set; }
    private string PatchesJson { get; set; } = "[]";
    private string FceContentsJson { get; set; } = "{}";

    private Guid DialogId { get; set; }
    private string StateId { get; set; } = "";

    private bool _showPopUp;
    private string? _header;
    private string? _message;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(Request.Party) || string.IsNullOrWhiteSpace(Request.ServiceResource))
        {
            ShowPopup("Error", "Party and Service Resource are required.");
            return;
        }

        JsonArray patches;
        try
        {
            if (JsonNode.Parse(PatchesJson) is not JsonArray array)
            {
                ShowPopup("Error", "Patches must be a JSON array.");
                return;
            }
            patches = array;
        }
        catch (JsonException ex)
        {
            ShowPopup("Error", $"Invalid Patches JSON: {ex.Message}");
            return;
        }

        Dictionary<string, FceContent> fceContents;
        try
        {
            fceContents = string.IsNullOrWhiteSpace(FceContentsJson)
                ? new Dictionary<string, FceContent>()
                : JsonSerializer.Deserialize<Dictionary<string, FceContent>>(FceContentsJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                  ?? new Dictionary<string, FceContent>();
        }
        catch (JsonException ex)
        {
            ShowPopup("Error", $"Invalid FCE contents JSON: {ex.Message}");
            return;
        }

        if (patches.Count == 0)
        {
            ShowPopup("Error", "Need at least 1 Patch.");
            return;
        }
        if (Cursor < 0 || Cursor >= patches.Count)
        {
            ShowPopup("Error", "Cursor is out of range.");
            return;
        }

        var dto = new V1ServiceOwnerDialogsCommandsCreate_Dialog
        {
            ServiceResource = Request.ServiceResource,
            Party = Request.Party,
            Content = new V1ServiceOwnerDialogsCommandsCreate_Content
            {
                Title = new V1CommonContent_ContentValue
                {
                    Value =
                    [
                        new V1CommonLocalizations_Localization
                        {
                            Value = "Playbook",
                            LanguageCode = "en"
                        }
                    ],
                    MediaType = "text/plain"
                },
                Summary = new V1CommonContent_ContentValue
                {
                    Value =
                    [
                        new V1CommonLocalizations_Localization
                        {
                            Value = "Playbook dialog",
                            LanguageCode = "en"
                        }
                    ],
                    MediaType = "text/plain"
                }
            },
            SearchTags =
            [
                new V1ServiceOwnerDialogsCommandsCreate_Tag
                {
                    Value = "Playbook"
                }
            ]
        };

        var dialogResult = await ServiceOwnerApi.V1ServiceOwnerDialogsCommandsCreateDialog(dto, CancellationToken.None);
        if (!dialogResult.IsSuccessful)
        {
            Logger.LogWarning(
                "Dialogporten POST /dialogs returned {StatusCode}. Body: {Body}",
                (int)dialogResult.StatusCode, dialogResult.Error?.Content);
            ShowPopup(dialogResult.StatusCode.ToString(), dialogResult.Error?.Content ?? "Failed to create dialog.");
            return;
        }

        var guidString = (dialogResult.Content ?? string.Empty).Trim('"');
        if (!Guid.TryParse(guidString, out var dialogId))
        {
            ShowPopup("Error", "Parse Guid failed.");
            return;
        }

        var blueprint = new PlaybookBlueprint(dialogId, patches, fceContents);
        var stateId = await StateStore.CreateAsync(blueprint, CancellationToken.None);

        var compiler = new PlaybookCompiler(ServiceProviderOptions.Value) { Progress = 0 };
        var compiledPatches = await compiler.CompilePatches(stateId, blueprint, Cursor);
        if (compiledPatches.Count == 0)
        {
            ShowPopup("Error", "Cursor produced no patches.");
            return;
        }

        var patchResult = await ServiceOwnerApi.V1ServiceOwnerDialogsPatchDialog(dialogId, compiledPatches, null, CancellationToken.None);
        if (!patchResult.IsSuccessStatusCode)
        {
            Logger.LogWarning(
                "Dialogporten PATCH /dialogs/{DialogId} (bootstrap stage {Cursor}) returned {StatusCode}. Body: {Body}",
                dialogId, Cursor, (int)patchResult.StatusCode, patchResult.Error?.Content);
            ShowPopup(patchResult.StatusCode.ToString(), patchResult.Error?.Content ?? "Failed to apply bootstrap patches.");
            return;
        }

        DialogId = dialogId;
        StateId = stateId;

        var dialogStorageResult = await ProtectedLocalStore.GetAsync<List<Guid>>("dialogs");
        var dialogs = dialogStorageResult is { Success: true, Value: not null }
            ? dialogStorageResult.Value
            : [];
        dialogs.Add(dialogId);
        _ = ProtectedLocalStore.SetAsync("dialogs", dialogs);

        ShowPopup("Playbook ready", $"Dialog {dialogId} created. Open it in Arbeidsflate and click through.");
    }

    private void Prefill()
    {
        Request.Party = "urn:altinn:person:identifier-no:08895699684";
        Request.ServiceResource = "urn:altinn:resource:super-simple-service";
        Cursor = 0;
        PatchesJson = CreatePlaybookSamples.Patches;
        FceContentsJson = CreatePlaybookSamples.FceContents;
    }

    private async Task ImportFromJson()
    {
        var importJson = await Js.InvokeAsync<string>("eval", "(document.getElementById('import') || {value: ''}).value");

        if (string.IsNullOrWhiteSpace(importJson))
        {
            ShowPopup("Error", "Paste the playbook JSON first.");
            return;
        }

        JsonNode? root;
        try
        {
            root = JsonNode.Parse(importJson);
        }
        catch (JsonException ex)
        {
            ShowPopup("Error", $"Invalid JSON: {ex.Message}");
            return;
        }

        if (root is not JsonObject obj)
        {
            ShowPopup("Error", "Top-level JSON must be an object.");
            return;
        }

        var playbookState = FindProperty(obj, "playbookState") as JsonObject;
        if (playbookState is null)
        {
            ShowPopup("Error", "Missing playbookState object.");
            return;
        }

        var patchesNode = FindProperty(playbookState, "Patches") as JsonArray;
        if (patchesNode is null)
        {
            ShowPopup("Error", "Missing playbookState.Patches array.");
            return;
        }

        var indented = new JsonSerializerOptions { WriteIndented = true };

        Request.Party = FindStringProperty(obj, "Party") ?? "";
        Request.ServiceResource = FindStringProperty(obj, "serviceResource") ?? "";
        Cursor = FindProperty(playbookState, "Cursor")?.GetValue<int>() ?? 0;
        PatchesJson = patchesNode.ToJsonString(indented);

        var fceNode = FindProperty(obj, "fceContents");
        FceContentsJson = fceNode?.ToJsonString(indented) ?? "{}";

        ShowPopup("Imported", "Form populated from playbook JSON. Review the fields and click Create Playbook.");
    }

    private static JsonNode? FindProperty(JsonObject obj, string name)
    {
        foreach (var kvp in obj)
        {
            if (string.Equals(kvp.Key, name, StringComparison.OrdinalIgnoreCase))
            {
                return kvp.Value;
            }
        }
        return null;
    }

    private static string? FindStringProperty(JsonObject obj, string name)
    {
        return FindProperty(obj, name)?.GetValue<string>();
    }

    private void ShowPopup(string header, string message)
    {
        _header = header;
        _message = message;
        _showPopUp = true;
    }
}
